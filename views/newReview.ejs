<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="./styles/main.css">
    <title>New Review</title>
    <h1>Please add your review</h1>
    <%# This form allows the creation of a new review %>
    <form action="/new" id="newReview" method="post">
        <div class="formElement">
        <p>Book Name</p>
        <input type="text" name="Name" placeholder="Book Name">
        </div>
        <div class="formElement">
        <p>ISBN</p>
        <input type="text" name="isbn" placeholder="Book ISBN">
        </div>
        <div class="formElement">
        <p>Author</p> 
        <input type="text" name="Author" placeholder="Book Author">
        </div>
        <div class="formElement">
        <p>Rating out of 5</p> 
        <input type="number" name="Rating" min="1" max="5">
        </div>
        <div class="formElement">
        <p>Your full review</p>
        <textarea name="Review" Enter your review here></textarea> 
        </div>
        <div class="formElement">
        <button id="submitReview" style="background-color: orange;" type="submit">Submit Review</button>
        </div>
    </form>
</head>
<body>
    
</body>
</html>